{
  "name": "toronto-rental-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Monitors Greater Toronto rental listings and scores them against configurable tenant profiles.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "build": "nest build -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:generate:unsafe": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "seed:refresh": "tsx src/seed/index.ts --refresh",
    "profile:sync": "tsx src/profiles/sync-profile.ts",
    "verify": "tsx src/verify.ts",
    "cycle": "pnpm build && node dist/run-cycle.js",
    "cycle:dry": "pnpm build && node dist/run-cycle.js --dry-run",
    "cycle:stored": "pnpm build && node dist/run-cycle.js --stored",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cycle:buildings": "pnpm build && node dist/run-cycle.js --buildings",
    "probe": "pnpm build && node dist/probe-sources.js",
    "probe:dry": "pnpm build && node dist/probe-sources.js --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
