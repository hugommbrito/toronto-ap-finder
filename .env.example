# Postgres runs on 5433 by default to avoid clashing with a local 5432 install.
DATABASE_URL=postgres://rental:rental@localhost:5433/rental_monitor

POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental_monitor
POSTGRES_PORT=5433

# Identifiable User-Agent is mandatory for Nominatim and is good conduct everywhere else.
# Put your real address in .env (git-ignored) — never here.
SCRAPER_CONTACT_EMAIL=you@example.com

# Secrets. Seeding and tests do not need these.
TELEGRAM_BOT_TOKEN=
# Comma-separated: everyone listed receives every notification.
# e.g. TELEGRAM_CHAT_IDS=100000001,100000002
TELEGRAM_CHAT_IDS=

# Listing verification. Without it the pipeline runs and notifies exactly as before,
# skipping the check — see README, "Verifying what is actually for rent".
ANTHROPIC_API_KEY=

# Set to false to run the service without the 20-minute polling cycle.
CYCLE_ENABLED=true

NODE_ENV=development
PORT=3000

# Overrides the vantage-point label the source probe records. Normally derived from Railway's
# environment/region, or the hostname. A verdict belongs to a (source, vantage point) pair, so a
# local run is recorded separately and never overwrites the deployment's.
PROBE_HOST_LABEL=

# Set to false to run the service without the weekly source probe.
PROBE_ENABLED=true

# Bearer token for GET /operations, the summary of what worked and what failed.
# Unset closes the route: it reports addresses, prices and failure detail.
OPERATIONS_TOKEN=
